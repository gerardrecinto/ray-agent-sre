{
  "title": "Ray + LangGraph SRE",
  "uid": "ray-agent-sre",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cluster nodes (total vs alive)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "ray_cluster_node_count", "legendFormat": "total" },
        { "expr": "ray_cluster_alive_node_count", "legendFormat": "alive" }
      ]
    },
    {
      "id": 2,
      "title": "Node up (per node_id)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "ray_node_up", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 3,
      "title": "Cluster CPU (total vs available)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "ray_cluster_cpu_total", "legendFormat": "total" },
        { "expr": "ray_cluster_cpu_available", "legendFormat": "available" }
      ]
    },
    {
      "id": 4,
      "title": "Actors by state",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "ray_actor_state_count", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 5,
      "title": "Tasks by state",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "ray_task_state_count", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 6,
      "title": "LangGraph node runs / errors / retries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(langgraph_node_runs_total[5m])", "legendFormat": "runs {{node}}" },
        { "expr": "rate(langgraph_node_errors_total[5m])", "legendFormat": "errors {{node}}" },
        { "expr": "rate(langgraph_node_retries_total[5m])", "legendFormat": "retries {{node}}" }
      ]
    },
    {
      "id": 7,
      "title": "LangGraph node latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(langgraph_node_latency_seconds_bucket[5m])) by (le, node))",
          "legendFormat": "p50 {{node}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(langgraph_node_latency_seconds_bucket[5m])) by (le, node))",
          "legendFormat": "p95 {{node}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(langgraph_node_latency_seconds_bucket[5m])) by (le, node))",
          "legendFormat": "p99 {{node}}"
        }
      ]
    }
  ]
}
